# === Claude / Anthropic (erforderlich) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# === Sprache ===
LANGUAGE=de

# === Speech-to-Text ===
# local = faster-whisper, läuft offline & kostenlos auf diesem Rechner
# cloud = OpenAI Whisper API (benötigt OPENAI_API_KEY)
STT_PROVIDER=local
STT_LOCAL_MODEL=small
STT_LOCAL_DEVICE=cpu
OPENAI_API_KEY=

# === Text-to-Speech ===
# windows = lokale Windows-Sprachausgabe (SAPI via pyttsx3), kostenlos
# cloud   = externer TTS-Dienst (Platzhalter, eigener API-Key nötig)
# custom  = eigene Implementierung
TTS_PROVIDER=windows
TTS_VOICE=
TTS_SPEED=1.0

# === Wake Word ===
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis

# === Logging ===
LOG_LEVEL=INFO
